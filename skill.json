{
  "name": "genpark-dynamic-aspect-ratio-visual-patch-tokenizer-skill",
  "version": "1.0.0",
  "description": "GenPark AI Agent Skill - Dynamic aspect ratio visual patch tokenizer processing arbitrary image dimensions with 2D rotary position embeddings.",
  "author": "genpark",
  "category": "vision-language",
